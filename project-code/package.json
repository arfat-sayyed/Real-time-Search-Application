{
  "name": "realtime-product-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "test": "pnpm --filter api test",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "seed": "pnpm --filter api seed",
    "elastic:up": "docker compose up -d elasticsearch",
    "elastic:down": "docker compose down"
  }
}
